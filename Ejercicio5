import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;
import java.util.Scanner;

public class Ejercicio1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        try (BufferedWriter bw = new BufferedWriter(new FileWriter("estudiantes.txt"))) {
            for (int i = 1; i <= 3; i++) {
                System.out.print("Nombre del estudiante " + i + ": ");
                String nombre = sc.nextLine();

                System.out.print("Calificación de " + nombre + ": ");
                double calificacion = Double.parseDouble(sc.nextLine().replace(",", "."));

                // Cada estudiante ocupa dos líneas
                bw.write(nombre);
                bw.newLine();
                bw.write(String.valueOf(calificacion));
                bw.newLine();
            }
            System.out.println("Datos guardados en estudiantes.txt");
        } catch (IOException e) {
            System.out.println("Error al escribir el archivo: " + e.getMessage());
        } catch (NumberFormatException e) {
            System.out.println("La calificación debe ser un número.");
        } finally {
            sc.close();
        }
    }
}
